# Copy to .env (cp .env.example .env) and fill in the values.
# .env is git-ignored; this example file is the only .env* file that is committed.
# Never put real credentials in this example file.

# --- Required: your Zendesk account ------------------------------------------
# The part before .zendesk.com in your Zendesk URL.
ZENDESK_SUBDOMAIN=your-subdomain
# The agent account this tool acts as ("Me" in the UI).
ZENDESK_EMAIL=you@example.com
# Zendesk API token (Admin Center -> Apps and integrations -> APIs -> Zendesk API).
ZENDESK_API_KEY=

# --- Required: OAuth client (used for the Reconnect flow) ---------------------
# Created in Admin Center -> Apps and integrations -> APIs -> Zendesk API -> OAuth Clients.
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
# Must match a Redirect URL registered on that OAuth client, character for
# character. The default below is used when this line is omitted.
ZENDESK_REDIRECT_URI=https://localhost/callback
# ZENDESK_OAUTH_SCOPES=read write

# --- Optional: token file ------------------------------------------------------
# Where the OAuth tokens are stored. Default: .zendesk_oauth_tokens.json in this
# repo's root. Set an absolute path only to share one token file with a
# zendesk-mcp-server checkout that also refreshes it.
# ZENDESK_OAUTH_TOKEN_PATH=/absolute/path/to/zendesk-mcp-server/.zendesk_oauth_tokens.json

# --- Optional: team-specific lists (the built-in defaults are one team's names) --
# Names exactly as the standup notes spell them (case-insensitive).
# STANDUP_PEOPLE=Alex,Sam,Jordan
# Whose updates the third /standup tab lists (and the tab's label).
# STANDUP_TRACKED_PERSON=Jordan
# Full Zendesk display names for the /overview cards; the first is you.
# OVERVIEW_PEOPLE=Alex Example,Sam Example,Jordan Example

# --- Optional: other knobs (see README for the full table) ----------------------
# ZENDESK_REVIEW_PORT=8765
# ZENDESK_NOTIFICATION_SOUND=Glass
# ZENDESK_LOOKBACK_HOURS=72
