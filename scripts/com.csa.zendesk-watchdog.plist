<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.csa.zendesk-watchdog</string>

    <!-- Deliberately NOT the zendesk-mcp-server venv: watchdog.py has zero
         third-party dependencies on purpose, so it keeps working even if
         that venv breaks again (that's the whole point of it). This is the
         standalone uv-managed CPython that venv is built on, not the venv
         itself -- no installed packages are involved.

         Not /usr/bin/python3 any more: macOS's privacy protection blocks
         the Command Line Tools python3 from reading anything under
         ~/Desktop when launchd runs it ("Operation not permitted" in
         watchdog.err.log on every run), so the watchdog never actually
         ran. This interpreter already has that access (it's what the
         review server and first-reply check run on). If a uv upgrade
         removes this exact version, point this at the new
         ~/.local/share/uv/python/cpython-*/bin/python3.x. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/catherinevee/.local/share/uv/python/cpython-3.12.13-macos-aarch64-none/bin/python3.12</string>
        <string>/Users/catherinevee/Desktop/git/sla-task-firstreply/scripts/watchdog.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/catherinevee/Desktop/git/sla-task-firstreply</string>

    <!-- Checks every 5 minutes: is review_server actually answering HTTP
         requests, and has first_reply_check completed a scan recently
         during business hours. Fires a macOS notification on a new
         problem (or a still-unresolved one after a 30-minute cooldown,
         see watchdog.py) and again once things recover. RunAtLoad so a
         problem already present at boot/login gets flagged within seconds
         instead of waiting for the first 5-minute tick. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/catherinevee/Desktop/git/sla-task-firstreply/scripts/output/watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/catherinevee/Desktop/git/sla-task-firstreply/scripts/output/watchdog.err.log</string>
</dict>
</plist>
